<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_category_list" model="ir.ui.view">
        <field name="name">service.category.list</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <list string="Категории услуг">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="provider_count"/>
            </list>
        </field>
    </record>

    <record id="view_service_category_form" model="ir.ui.view">
        <field name="name">service.category.form</field>
        <field name="model">service.category</field>
        <field name="arch" type="xml">
            <form string="Категория услуги">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="icon"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_service_category" model="ir.actions.act_window">
        <field name="name">Категории услуг</field>
        <field name="res_model">service.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
