<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== SEARCH (фильтры US1) ==================== -->
    <record id="view_service_provider_search" model="ir.ui.view">
        <field name="name">service.provider.search</field>
        <field name="model">service.provider</field>
        <field name="arch" type="xml">
            <search string="Поиск исполнителя">
                <field name="name" string="Мастер"/>
                <field name="category_id"/>
                <field name="district"/>

                <!-- Срочность -->
                <filter string="Срочно" name="urgency_urgent"
                        domain="[('urgency', '=', 'urgent')]"/>
                <filter string="2-3 дня" name="urgency_standard"
                        domain="[('urgency', '=', 'standard')]"/>
                <filter string="По записи" name="urgency_scheduled"
                        domain="[('urgency', '=', 'scheduled')]"/>

                <separator/>

                <!-- География: близость к магазину -->
                <filter string="Рядом (до 5 км)" name="dist_near"
                        domain="[('distance_km', '&lt;=', 5)]"/>
                <filter string="Средне (5-15 км)" name="dist_mid"
                        domain="[('distance_km', '&gt;', 5), ('distance_km', '&lt;=', 15)]"/>
                <filter string="Далеко (&gt; 15 км)" name="dist_far"
                        domain="[('distance_km', '&gt;', 15)]"/>

                <separator/>

                <!-- Цена -->
                <filter string="До 2 000 ₽" name="price_low"
                        domain="[('price_to', '&lt;=', 2000)]"/>
                <filter string="2 000 - 5 000 ₽" name="price_mid"
                        domain="[('price_from', '&gt;=', 2000), ('price_to', '&lt;=', 5000)]"/>
                <filter string="Более 5 000 ₽" name="price_high"
                        domain="[('price_from', '&gt;', 5000)]"/>

                <separator/>

                <!-- Рейтинг -->
                <filter string="Рейтинг от 4" name="rating_high"
                        domain="[('rating', '&gt;=', 4)]"/>

                <group>
                    <filter string="Категория" name="group_category"
                            context="{'group_by': 'category_id'}"/>
                    <filter string="Срочность" name="group_urgency"
                            context="{'group_by': 'urgency'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== KANBAN (каталог, основной экран US1) ==================== -->
    <record id="view_service_provider_kanban" model="ir.ui.view">
        <field name="name">service.provider.kanban</field>
        <field name="model">service.provider</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="category_id">
                <field name="name"/>
                <field name="category_id"/>
                <field name="rating"/>
                <field name="review_count"/>
                <field name="price_from"/>
                <field name="price_to"/>
                <field name="distance_km"/>
                <field name="urgency"/>
                <field name="photo"/>
                <field name="phone"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex">
                            <field name="photo" widget="image"
                                   class="o_kanban_image rounded-circle mr-3"
                                   options="{'size': [64, 64]}"/>
                            <div class="flex-grow-1">
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="category_id"/></div>
                                <div>
                                    ⭐ <field name="rating"/> (<field name="review_count"/> отзывов)
                                </div>
                                <div>
                                    💰 <field name="price_from"/>–<field name="price_to"/> ₽
                                </div>
                                <div>
                                    📍 <field name="distance_km"/> км
                                </div>
                                <div invisible="not phone">
                                    📞 <field name="phone"/>
                                </div>
                                <span class="badge"
                                      t-attf-class="badge-{{record.urgency.raw_value == 'urgent' and 'danger' or (record.urgency.raw_value == 'standard' and 'warning' or 'secondary')}}">
                                    <field name="urgency"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== LIST ==================== -->
    <record id="view_service_provider_list" model="ir.ui.view">
        <field name="name">service.provider.list</field>
        <field name="model">service.provider</field>
        <field name="arch" type="xml">
            <list string="Исполнители" decoration-success="rating &gt;= 4">
                <field name="name"/>
                <field name="category_id"/>
                <field name="rating"/>
                <field name="review_count"/>
                <field name="price_from"/>
                <field name="price_to"/>
                <field name="distance_km"/>
                <field name="district"/>
                <field name="urgency"/>
                <field name="phone"/>
                <field name="partner_id" string="Контакт"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM ==================== -->
    <record id="view_service_provider_form" model="ir.ui.view">
        <field name="name">service.provider.form</field>
        <field name="model">service.provider</field>
        <field name="arch" type="xml">
            <form string="Исполнитель">
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Имя мастера"/></h1>
                    </div>
                    <group>
                        <group string="Основное">
                            <field name="category_id"/>
                            <field name="phone"/>
                            <field name="partner_id"/>
                            <field name="district"/>
                            <field name="active"/>
                        </group>
                        <group string="Критерии поиска (US1)">
                            <label for="price_from" string="Стоимость, ₽"/>
                            <div class="o_row">
                                <field name="price_from"/> — <field name="price_to"/>
                            </div>
                            <field name="distance_km"/>
                            <field name="urgency"/>
                        </group>
                    </group>
                    <group string="Рейтинг">
                        <field name="rating" readonly="1"/>
                        <field name="review_count" readonly="1"/>
                    </group>
                    <field name="description" placeholder="Описание, специализация, опыт работы..."/>
                    <notebook>
                        <page string="Отзывы">
                            <field name="review_ids">
                                <list editable="bottom">
                                    <field name="author_id"/>
                                    <field name="rating"/>
                                    <field name="comment"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_service_provider" model="ir.actions.act_window">
        <field name="name">Каталог исполнителей</field>
        <field name="res_model">service.provider</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_service_provider_search"/>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Добавьте первого исполнителя в каталог
            </p>
        </field>
    </record>

</odoo>
