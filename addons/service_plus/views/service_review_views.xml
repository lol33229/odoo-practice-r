<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_service_review_list" model="ir.ui.view">
        <field name="name">service.review.list</field>
        <field name="model">service.review</field>
        <field name="arch" type="xml">
            <list string="Отзывы" editable="bottom">
                <field name="provider_id"/>
                <field name="author_id"/>
                <field name="rating"/>
                <field name="comment"/>
            </list>
        </field>
    </record>

    <record id="action_service_review" model="ir.actions.act_window">
        <field name="name">Отзывы</field>
        <field name="res_model">service.review</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
